# KSI-SVC-ASM / KSI-SVC-VRI / KSI-CNA-DFP: Automated Secret Management
# Validates that all ScanSet secrets are stored in Secrets Manager,
# encrypted with the CMK, and have active current versions:
# - DB credentials secret
# - PKI IA private key secret
# - PKI IA certificate secret
# - PKI certificate chain secret
# - PKI root CA certificate secret

META
    esp_id `ksi-svc-asm-svc-vri-secrets-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `critical`

    title `KSI-SVC-ASM / KSI-SVC-VRI / KSI-CNA-DFP: Automated Secret Management`
    description `Validates all ScanSet secrets exist in Secrets Manager, are encrypted with the KMS CMK, and have active current versions`
    author `example-security`
    tags `aws,secretsmanager,kms,pki,credentials,fedramp,KSI-SVC-ASM,KSI-SVC-VRI,KSI-CNA-DFP`

    control_mapping `KSI:KSI-SVC-ASM,KSI:KSI-SVC-VRI,KSI:KSI-CNA-DFP`
    control_objective `KSI-SVC-ASM,KSI-SVC-VRI,KSI-CNA-DFP`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `AWS:us-east-1:secrets-infrastructure`
    customer_responsibility `configuration`

    remediation_days `1`
    recommendation `Ensure all five secrets exist in Secrets Manager with KmsKeyId set to the CMK ARN and has_current_version = true.`

    component_id `comp-aws-secrets`

    impl_KSI_SVC_ASM `Automated secret management is validated by confirming all five ScanSet secrets are stored in AWS Secrets Manager rather than in environment variables, configuration files, or instance metadata: database credentials (example-org/db/credentials), PKI issuing authority key (example-org/pki/ia-key), PKI issuing authority certificate (example-org/pki/ia-cert), certificate chain (example-org/pki/chain), and root CA (example-org/pki/root-ca). Each secret is validated to have an AWSCURRENT version (has_current_version = true), confirming the secrets are populated and accessible to the instance at runtime.`

    impl_KSI_SVC_VRI `Secret integrity is validated by confirming all five secrets are encrypted with the ScanSet KMS customer managed key (kms_key_id starts arn:aws:kms:). This ensures secret values are protected at rest using FIPS 140-2 validated encryption rather than the default AWS managed key, and that only principals explicitly granted access in the KMS key policy can decrypt the secrets. The presence of an AWSCURRENT version further confirms the secrets have not been deleted or invalidated.`

    impl_KSI_CNA_DFP `Secret scope and functionality definition is validated by confirming each secret has a description that identifies its purpose and a SecretType tag classifying it (database or pki). The PKI IA key secret is additionally tagged with Sensitive=critical, confirming the highest-sensitivity credential is identified and scoped appropriately. All secrets are managed by Terraform (tag_key:ManagedBy = terraform), confirming secret lifecycle is defined in infrastructure-as-code rather than created ad-hoc.`

META_END

DEF
    VAR aws_region string `us-east-1`
    VAR kms_key_arn string `arn:aws:kms:us-east-1:123456789012:key/example-key-id-0000-0000-000000000000`

    OBJECT db_credentials
        secret_id `example-org/db/credentials`
        region VAR aws_region
    OBJECT_END

    OBJECT pki_ia_key
        secret_id `example-org/pki/ia-key`
        region VAR aws_region
    OBJECT_END

    OBJECT pki_ia_cert
        secret_id `example-org/pki/ia-cert`
        region VAR aws_region
    OBJECT_END

    OBJECT pki_chain
        secret_id `example-org/pki/chain`
        region VAR aws_region
    OBJECT_END

    OBJECT pki_root_ca
        secret_id `example-org/pki/root-ca`
        region VAR aws_region
    OBJECT_END

    # All secrets: exist, KMS encrypted with CMK, has active version
    STATE secret_compliant
        found boolean = true
        kms_key_id string = VAR kms_key_arn
        has_current_version boolean = true
    STATE_END

    CRI AND
        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF secret_compliant
            OBJECT_REF db_credentials
        CTN_END

        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF secret_compliant
            OBJECT_REF pki_ia_key
        CTN_END

        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF secret_compliant
            OBJECT_REF pki_ia_cert
        CTN_END

        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF secret_compliant
            OBJECT_REF pki_chain
        CTN_END

        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF secret_compliant
            OBJECT_REF pki_root_ca
        CTN_END
    CRI_END
DEF_END
