# KSI-SVC-EIS: Evaluating and Improving Security
# Validates that ScanSet persistently evaluates information resources
# for security improvement opportunities:
# - Security Hub: auto-enable controls, FSBP and NIST 800-53 standards active
# - GuardDuty: RDS login events and runtime monitoring features reflect evaluated posture
# - Security findings bucket: lifecycle configured for long-term retention review

META
    # === Required ===
    esp_id `ksi-svc-eis-evaluating-improving-security-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `high`

    # === Documentation ===
    title `KSI-SVC-EIS: Evaluating and Improving Security`
    description `Validates Security Hub continuous control evaluation, GuardDuty feature posture, and findings retention lifecycle satisfy KSI-SVC-EIS persistent evaluation of information resources for security improvement`
    author `example-security`
    tags `aws,securityhub,guardduty,s3,lifecycle,evaluation,fedramp,KSI-SVC-EIS`

    # === Control Mapping ===
    control_mapping `KSI:KSI-SVC-EIS`
    control_objective `KSI-SVC-EIS`

    # === Assessment ===
    assessment_method `TEST`

    # === Implementation ===
    implementation_status `implemented`
    responsible_role `system-admin`

    # === Inheritance ===
    control_origination `sp-system`
    inherited_from `AWS:us-east-1:security-infrastructure`
    customer_responsibility `configuration`

    # === Remediation ===
    remediation_days `7`
    recommendation `Enable Security Hub auto_enable_controls and subscribe to FSBP and NIST 800-53 standards. Configure findings bucket lifecycle to retain findings for 2555 days.`

    # === Component ===
    component_id `comp-aws-security`

    # === Implementation Narratives ===
    impl_KSI_SVC_EIS `Continuous monitoring is validated by confirming Security Hub has auto_enable_controls set to true, ensuring new controls are automatically evaluated when subscribed standards are updated. The presence of both AWS Foundational Security Best Practices (standard_fsbp_enabled = true) and NIST SP 800-53 (standard_nist_800_53_enabled = true) standards in READY status confirms persistent automated assessment of the account against recognized security baselines.`

    impl_KSI_SVC_EIS `Flaw remediation identification is validated by confirming Security Hub is actively evaluating controls against FSBP and NIST 800-53 standards (standards_count >= 2, all READY). Security Hub surfaces failed controls as findings, providing the persistent identification of security improvement opportunities required by KSI-SVC-EIS. The control_finding_generator field is validated to confirm findings are generated at the individual security control level for precise remediation guidance.`

    impl_KSI_SVC_EIS `Least functionality evaluation is validated by confirming GuardDuty has the RDS_LOGIN_EVENTS feature enabled, providing persistent evaluation of database access patterns against expected behavior. GuardDuty detector status is confirmed ENABLED to validate that the automated security evaluation capability is operational and not degraded.`

    impl_KSI_SVC_EIS `Security architecture evaluation is validated by confirming the security findings S3 bucket has a lifecycle rule enabled (lifecycle_enabled = true) with retention configured for 2555 days. This confirms that historical security findings are retained for long-term trend analysis and security improvement review, satisfying the persistent evaluation of security effectiveness required by KSI-SVC-EIS.`

META_END

DEF
    # ==========================================================================
    # Variables
    # ==========================================================================
    VAR aws_region string `us-east-1`
    VAR guardduty_detector_id string `00000000000000000000000000000000`
    VAR security_bucket_name string `example-org-security-findings`

    # ==========================================================================
    # Objects
    # ==========================================================================

    OBJECT main_detector
        detector_id VAR guardduty_detector_id
        region VAR aws_region
    OBJECT_END

    OBJECT security_hub
        region VAR aws_region
    OBJECT_END

    OBJECT security_findings_bucket
        bucket_name VAR security_bucket_name
        region VAR aws_region
    OBJECT_END

    # ==========================================================================
    # States
    # ==========================================================================

    # Security Hub: auto-enable controls, required standards active
    STATE securityhub_evaluation_active
        found boolean = true
        auto_enable_controls boolean = true
        control_finding_generator string = `SECURITY_CONTROL`
        standard_fsbp_enabled boolean = true
        standard_nist_800_53_enabled boolean = true
        standards_count int >= 2
    STATE_END

    # GuardDuty: detector enabled, RDS login monitoring active
    STATE guardduty_evaluation_active
        found boolean = true
        status string = `ENABLED`
        feature_rds_login_events string = `ENABLED`
        feature_cloud_trail string = `ENABLED`
        feature_s3_data_events string = `ENABLED`
    STATE_END

    # Security findings bucket: lifecycle configured for long-term retention
    STATE findings_retention_configured
        found boolean = true
        lifecycle_enabled boolean = true
        record
            field Lifecycle.Rules.0.Status string = `Enabled`
            field Lifecycle.Rules.0.Expiration.Days int = 2555
        record_end
    STATE_END

    # ==========================================================================
    # Criteria
    # ==========================================================================
    CRI AND
        # Security Hub continuously evaluating against FSBP and NIST 800-53
        CTN aws_securityhub_account
            TEST all all AND
            STATE_REF securityhub_evaluation_active
            OBJECT_REF security_hub
        CTN_END

        # GuardDuty actively evaluating threat posture including RDS and CloudTrail
        CTN aws_guardduty_detector
            TEST all all AND
            STATE_REF guardduty_evaluation_active
            OBJECT_REF main_detector
        CTN_END

        # Findings retained for 2555 days enabling long-term security trend analysis
        CTN aws_s3_bucket
            TEST all all AND
            STATE_REF findings_retention_configured
            OBJECT_REF security_findings_bucket
        CTN_END
    CRI_END
DEF_END
