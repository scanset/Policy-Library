# CIS AWS Storage Services Benchmark v1.0.0
# CIS 5.2 - Ensure S3 security findings bucket hardened

META
    esp_id `cis-aws-stor-5-2`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:5.2,NIST-800-53:AC-3,NIST-800-53:AT-2,KSI:KSI-AFR-ADS,KSI:KSI-CED-RGT`
    title `CIS 5.2 - Ensure S3 security findings bucket hardened`
    description `Verify security findings S3 bucket has versioning, KMS encryption, public access blocked, SSL enforced.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_3 `CIS 5.2: Ensure S3 security findings bucket hardened`
    impl_AT_2 `CIS 5.2: Ensure S3 security findings bucket hardened`
    impl_AU_4 `CIS 5.2: Ensure S3 security findings bucket hardened`
META_END

DEF
    OBJECT security_bucket
        bucket_name `SECURITY_FINDINGS_BUCKET`
    OBJECT_END

    STATE security_bucket_check
        found boolean = true
        versioning_status string = `Enabled`
        sse_algorithm string = `aws:kms`
        block_public_acls boolean = true
        ignore_public_acls boolean = true
        block_public_policy boolean = true
        restrict_public_buckets boolean = true
        ssl_enforced boolean = true
        lifecycle_enabled boolean = true
    STATE_END

    CRI AND
        CTN aws_s3_bucket
            TEST all all AND
            STATE_REF security_bucket_check
            OBJECT_REF security_bucket
        CTN_END
    CRI_END
DEF_END
