# CIS AWS Storage Services Benchmark v1.0.0
# CIS 6.1 - Ensure Elastic Disaster Recovery is configured

META
    esp_id `cis-aws-stor-6-1`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:6.1,NIST-800-53:CP-9,NIST-800-53:SI-3,KSI:KSI-AFR-SCN,KSI:KSI-AFR-VDR`
    title `CIS 6.1 - Ensure Elastic Disaster Recovery is configured`
    description `Verify AWS Backup vault exists, is encrypted with KMS, and is locked.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_CP_9 `CIS 6.1: Ensure Elastic Disaster Recovery is configured`
    impl_SI_3 `CIS 6.1: Ensure Elastic Disaster Recovery is configured`
META_END

DEF
    OBJECT backup_vault
        vault_name `BACKUP_VAULT_NAME`
    OBJECT_END

    STATE backup_vault_check
        found boolean = true
        encryption_key_arn string contains `KMS_KEY_ID`
        locked boolean = true
    STATE_END

    CRI AND
        CTN aws_backup_vault
            TEST all all AND
            STATE_REF backup_vault_check
            OBJECT_REF backup_vault
        CTN_END
    CRI_END
DEF_END
