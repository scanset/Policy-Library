# CIS AWS Storage Services Benchmark v1.0.0
# CIS 2.10 - Ensure CloudTrail audits storage operations

META
    esp_id `cis-aws-stor-2-10`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:2.10,NIST-800-53:AT-2,NIST-800-53:IA-2,KSI:KSI-CED-RGT,KSI:KSI-CED-RST`
    title `CIS 2.10 - Ensure CloudTrail audits storage operations`
    description `Verify CloudTrail is logging with validation, KMS encryption, and CW integration.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AT_2 `CIS 2.10: Ensure CloudTrail audits storage operations`
    impl_IA_2 `CIS 2.10: Ensure CloudTrail audits storage operations`
META_END

DEF
    OBJECT trail
        trail_name `CLOUDTRAIL_NAME`
    OBJECT_END

    STATE trail_check
        found boolean = true
        is_logging boolean = true
        log_file_validation_enabled boolean = true
        include_global_service_events boolean = true
        has_cloud_watch_logs boolean = true
        kms_key_id string contains `KMS_KEY_ID`
    STATE_END

    CRI AND
        CTN aws_cloudtrail
            TEST all all AND
            STATE_REF trail_check
            OBJECT_REF trail
        CTN_END
    CRI_END
DEF_END
