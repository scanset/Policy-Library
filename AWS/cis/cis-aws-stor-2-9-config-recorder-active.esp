# CIS AWS Storage Services Benchmark v1.0.0
# CIS 2.9 - Ensure AWS Config records storage resources

META
    esp_id `cis-aws-stor-2-9`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:2.9,NIST-800-53:AC-2,NIST-800-53:RA-5,KSI:KSI-AFR-ADS,KSI:KSI-AFR-SCN`
    title `CIS 2.9 - Ensure AWS Config records storage resources`
    description `Verify AWS Config recorder is active and recording all resource types.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_2 `CIS 2.9: Ensure AWS Config records storage resources`
    impl_RA_5 `CIS 2.9: Ensure AWS Config records storage resources`
META_END

DEF
    OBJECT config_recorder
        recorder_name `CONFIG_RECORDER_NAME`
    OBJECT_END

    STATE config_recorder_check
        found boolean = true
        recording boolean = true
        all_supported boolean = true
        include_global_resource_types boolean = true
    STATE_END

    CRI AND
        CTN aws_config_recorder
            TEST all all AND
            STATE_REF config_recorder_check
            OBJECT_REF config_recorder
        CTN_END
    CRI_END
DEF_END
