# CIS AWS Storage Services Benchmark v1.0.0
# CIS 2.12 - Ensure monitoring EC2 and EBS with CloudWatch

META
    esp_id `cis-aws-stor-2-12`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:2.12,NIST-800-53:AC-2,NIST-800-53:AU-2,KSI:KSI-AFR-ADS,KSI:KSI-CMT-LMC`
    title `CIS 2.12 - Ensure monitoring EC2 and EBS with CloudWatch`
    description `Verify CloudWatch log groups exist for monitoring with appropriate retention and encryption.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_2 `CIS 2.12: Ensure monitoring EC2 and EBS with CloudWatch`
    impl_AU_2 `CIS 2.12: Ensure monitoring EC2 and EBS with CloudWatch`
    impl_IA_2 `CIS 2.12: Ensure monitoring EC2 and EBS with CloudWatch`
META_END

DEF
    OBJECT cloudtrail_logs
        log_group_name `/CLOUDTRAIL_LOG_GROUP`
    OBJECT_END

    OBJECT security_logs
        log_group_name `/SECURITY_LOG_GROUP`
    OBJECT_END

    STATE cloudtrail_logs_check
        found boolean = true
        retention_in_days int >= 365
        kms_key_id string contains `KMS_KEY_ID`
    STATE_END

    STATE security_logs_check
        found boolean = true
        retention_in_days int >= 365
    STATE_END

    CRI AND
        CTN aws_cloudwatch_log_group
            TEST all all AND
            STATE_REF cloudtrail_logs_check
            OBJECT_REF cloudtrail_logs
        CTN_END
        CTN aws_cloudwatch_log_group
            TEST all all AND
            STATE_REF security_logs_check
            OBJECT_REF security_logs
        CTN_END
    CRI_END
DEF_END
