# CIS AWS Storage Services Benchmark v1.0.0
# CIS 2.11 - Ensure encryption key management

META
    esp_id `cis-aws-stor-2-11`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:2.11,NIST-800-53:AC-18,NIST-800-53:AC-2,KSI:KSI-CNA-ULN,KSI:KSI-IAM-APM`
    title `CIS 2.11 - Ensure encryption key management`
    description `Verify KMS key used for storage encryption has rotation enabled.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_18 `CIS 2.11: Ensure encryption key management`
    impl_AC_2 `CIS 2.11: Ensure encryption key management`
    impl_IA_2 `CIS 2.11: Ensure encryption key management`
META_END

DEF
    OBJECT secrets_key
        key_id `KMS_KEY_ID`
    OBJECT_END

    STATE secrets_key_check
        found boolean = true
        enabled boolean = true
        key_manager string = `CUSTOMER`
        rotation_enabled boolean = true
        rotation_period_in_days int <= 90
    STATE_END

    CRI AND
        CTN aws_kms_key
            TEST all all AND
            STATE_REF secrets_key_check
            OBJECT_REF secrets_key
        CTN_END
    CRI_END
DEF_END
