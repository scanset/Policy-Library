# CIS AWS Storage Services Benchmark v1.0.0
# CIS 2.13 - Ensure secrets encrypted with KMS

META
    esp_id `cis-aws-stor-2-13`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `CIS-AWS-Storage:2.13`
    title `CIS 2.13 - Ensure secrets encrypted with KMS`
    description `Verify all Secrets Manager secrets use customer-managed KMS encryption.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
META_END

DEF
    OBJECT db_creds
        secret_id `DB_SECRET_ID`
    OBJECT_END

    OBJECT pki_key
        secret_id `PKI_SECRET_ID`
    OBJECT_END

    STATE db_creds_check
        found boolean = true
        kms_key_id string contains `KMS_KEY_ID`
    STATE_END

    STATE pki_key_check
        found boolean = true
        kms_key_id string contains `KMS_KEY_ID`
    STATE_END

    CRI AND
        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF db_creds_check
            OBJECT_REF db_creds
        CTN_END
        CTN aws_secretsmanager_secret
            TEST all all AND
            STATE_REF pki_key_check
            OBJECT_REF pki_key
        CTN_END
    CRI_END
DEF_END
