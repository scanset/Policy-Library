# AWS Storage Services Benchmark v1.0.0
# 2.6 - Ensure proper IAM configuration for EC2

META
    esp_id `aws-stor-2-6`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AC-11,NIST-800-53:AC-2,KSI:KSI-IAM-APM,KSI:KSI-IAM-JIT`
    title `2.6 - Ensure proper IAM configuration for EC2`
    description `Verify EC2 instance has IAM instance profile and role with appropriate policies.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_11 `2.6: Ensure proper IAM configuration for EC2`
    impl_AC_2 `2.6: Ensure proper IAM configuration for EC2`
META_END

DEF
    OBJECT instance_profile
        instance_id `INSTANCE_ID`
    OBJECT_END

    OBJECT ec2_role
        role_name `EC2_ROLE_NAME`
    OBJECT_END

    STATE instance_profile_check
        found boolean = true
        iam_instance_profile_arn string contains `EC2_INSTANCE_PROFILE`
    STATE_END

    STATE ec2_role_check
        found boolean = true
        attached_policy_count int >= 3
    STATE_END

    CRI AND
        CTN aws_ec2_instance
            TEST all all AND
            STATE_REF instance_profile_check
            OBJECT_REF instance_profile
        CTN_END
        CTN aws_iam_role
            TEST all all AND
            STATE_REF ec2_role_check
            OBJECT_REF ec2_role
        CTN_END
    CRI_END
DEF_END
