# AWS Storage Services Benchmark v1.0.0
# 6.2 - Ensure AWS disaster recovery configuration

META
    esp_id `aws-stor-6-2`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AU-2,NIST-800-53:SC-23,KSI:KSI-AFR-ADS,KSI:KSI-AFR-VDR`
    title `6.2 - Ensure AWS disaster recovery configuration`
    description `Verify AWS Backup plan exists with multiple rules (daily, weekly, monthly).`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AU_2 `6.2: Ensure AWS disaster recovery configuration`
    impl_SC_23 `6.2: Ensure AWS disaster recovery configuration`
    impl_SI_4 `6.2: Ensure AWS disaster recovery configuration`
META_END

DEF
    OBJECT backup_plan
        plan_name `BACKUP_PLAN_NAME`
    OBJECT_END

    STATE backup_plan_check
        found boolean = true
        has_daily_rule boolean = true
        has_cross_region_copy boolean = true
    STATE_END

    CRI AND
        CTN aws_backup_plan
            TEST all all AND
            STATE_REF backup_plan_check
            OBJECT_REF backup_plan
        CTN_END
    CRI_END
DEF_END
