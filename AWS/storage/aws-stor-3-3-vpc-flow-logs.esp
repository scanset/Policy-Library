# AWS Storage Services Benchmark v1.0.0
# 3.3 - Ensure VPC integration with flow logging

META
    esp_id `aws-stor-3-3`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AT-2,NIST-800-53:CM-6,KSI:KSI-CED-RGT,KSI:KSI-CED-RST`
    title `3.3 - Ensure VPC integration with flow logging`
    description `Verify VPC flow logs are active and capturing all traffic to CloudWatch.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AT_2 `3.3: Ensure VPC integration with flow logging`
    impl_CM_6 `3.3: Ensure VPC integration with flow logging`
    impl_SC_28 `3.3: Ensure VPC integration with flow logging`
META_END

DEF
    OBJECT vpc_flow_logs
        resource_id `VPC_ID`
    OBJECT_END

    STATE vpc_flow_logs_check
        found boolean = true
        flow_log_status string = `ACTIVE`
        traffic_type string = `ALL`
        log_destination_type string = `cloud-watch-logs`
    STATE_END

    CRI AND
        CTN aws_flow_log
            TEST all all AND
            STATE_REF vpc_flow_logs_check
            OBJECT_REF vpc_flow_logs
        CTN_END
    CRI_END
DEF_END
