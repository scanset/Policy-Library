# AWS Storage Services Benchmark v1.0.0
# 3.5 - Ensure using security groups for VPC

META
    esp_id `aws-stor-3-5`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AC-3,NIST-800-53:IA-2,KSI:KSI-AFR-ADS,KSI:KSI-IAM-APM`
    title `3.5 - Ensure using security groups for VPC`
    description `Verify VPC endpoint security group restricts to VPC-internal HTTPS only.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_3 `3.5: Ensure using security groups for VPC`
    impl_IA_2 `3.5: Ensure using security groups for VPC`
META_END

DEF
    OBJECT vpce_sg
        group_id `VPCE_SECURITY_GROUP_ID`
    OBJECT_END

    STATE vpce_sg_check
        found boolean = true
        has_ingress_from_anywhere boolean = false
    STATE_END

    CRI AND
        CTN aws_security_group
            TEST all all AND
            STATE_REF vpce_sg_check
            OBJECT_REF vpce_sg
        CTN_END
    CRI_END
DEF_END
