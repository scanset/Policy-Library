# AWS Storage Services Benchmark v1.0.0
# 2.1 - Ensure EC2 instance with EBS

META
    esp_id `aws-stor-2-1`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AT-2,NIST-800-53:SC-28,KSI:KSI-CED-RGT,KSI:KSI-CED-RST`
    title `2.1 - Ensure EC2 instance with EBS`
    description `Verify EC2 instance is running with encrypted root volume, IMDSv2, no public IP, and instance profile.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AT_2 `2.1: Ensure EC2 instance with EBS`
    impl_SC_28 `2.1: Ensure EC2 instance with EBS`
META_END

DEF
    OBJECT target_instance
        instance_id `INSTANCE_ID`
    OBJECT_END

    STATE target_instance_check
        found boolean = true
        state string = `running`
        imdsv2_required boolean = true
        has_public_ip boolean = false
        root_volume_encrypted boolean = true
        iam_instance_profile_arn string contains `TENANT_PREFIX`
    STATE_END

    CRI AND
        CTN aws_ec2_instance
            TEST all all AND
            STATE_REF target_instance_check
            OBJECT_REF target_instance
        CTN_END
    CRI_END
DEF_END
