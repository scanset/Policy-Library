# AWS Storage Services Benchmark v1.0.0
# 5.1 - Ensure S3 audit logs bucket hardened

META
    esp_id `aws-stor-5-1`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AC-3,NIST-800-53:AT-2,KSI:KSI-AFR-ADS,KSI:KSI-CED-RGT`
    title `5.1 - Ensure S3 audit logs bucket hardened`
    description `Verify audit logs S3 bucket has versioning, KMS encryption, public access blocked, SSL enforced, lifecycle.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_3 `5.1: Ensure S3 audit logs bucket hardened`
    impl_AT_2 `5.1: Ensure S3 audit logs bucket hardened`
    impl_AU_4 `5.1: Ensure S3 audit logs bucket hardened`
META_END

DEF
    OBJECT audit_bucket
        bucket_name `AUDIT_LOGS_BUCKET`
    OBJECT_END

    STATE audit_bucket_check
        found boolean = true
        versioning_status string = `Enabled`
        sse_algorithm string = `aws:kms`
        block_public_acls boolean = true
        ignore_public_acls boolean = true
        block_public_policy boolean = true
        restrict_public_buckets boolean = true
        ssl_enforced boolean = true
        lifecycle_enabled boolean = true
        has_bucket_policy boolean = true
    STATE_END

    CRI AND
        CTN aws_s3_bucket
            TEST all all AND
            STATE_REF audit_bucket_check
            OBJECT_REF audit_bucket
        CTN_END
    CRI_END
DEF_END
