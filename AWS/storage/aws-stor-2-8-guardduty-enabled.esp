# AWS Storage Services Benchmark v1.0.0
# 2.8 - Ensure threat detection for storage

META
    esp_id `aws-stor-2-8`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AC-2,NIST-800-53:RA-5,KSI:KSI-AFR-ADS,KSI:KSI-AFR-SCN`
    title `2.8 - Ensure threat detection for storage`
    description `Verify GuardDuty is enabled with S3 data events and EBS malware scanning.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_2 `2.8: Ensure threat detection for storage`
    impl_RA_5 `2.8: Ensure threat detection for storage`
    impl_SA_3 `2.8: Ensure threat detection for storage`
META_END

DEF
    OBJECT guardduty
        detector_id `GUARDDUTY_DETECTOR_ID`
    OBJECT_END

    STATE guardduty_check
        found boolean = true
        status string = `ENABLED`
        feature_s3_data_events string = `ENABLED`
        feature_ebs_malware_protection string = `ENABLED`
        has_publishing_destination boolean = true
    STATE_END

    CRI AND
        CTN aws_guardduty_detector
            TEST all all AND
            STATE_REF guardduty_check
            OBJECT_REF guardduty
        CTN_END
    CRI_END
DEF_END
