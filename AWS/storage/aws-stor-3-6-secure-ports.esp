# AWS Storage Services Benchmark v1.0.0
# 3.6 - Ensure secure ports

META
    esp_id `aws-stor-3-6`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping `NIST-800-53:AC-3,NIST-800-53:SI-8,KSI:KSI-AFR-ADS,KSI:KSI-CNA-RNT`
    title `3.6 - Ensure secure ports`
    description `Verify ALB security group does not allow unrestricted ingress on non-standard ports.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
    impl_AC_3 `3.6: Ensure secure ports`
    impl_SI_8 `3.6: Ensure secure ports`
META_END

DEF
    OBJECT alb_sg
        group_id `ALB_SECURITY_GROUP_ID`
    OBJECT_END

    STATE alb_sg_check
        found boolean = true
    STATE_END

    CRI AND
        CTN aws_security_group
            TEST all all AND
            STATE_REF alb_sg_check
            OBJECT_REF alb_sg
        CTN_END
    CRI_END
DEF_END
