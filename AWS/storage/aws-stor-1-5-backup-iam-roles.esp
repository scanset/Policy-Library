# AWS Storage Services Benchmark v1.0.0
# 1.5 - Ensure IAM roles for backup

META
    esp_id `aws-stor-1-5`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `aws`
    criticality `medium`
    control_mapping ``
    title `1.5 - Ensure IAM roles for backup`
    description `Verify backup role and backup-prep role exist.`
    author `example-security`
    assessment_method `TEST`
    implementation_status `implemented`
META_END

DEF
    OBJECT backup_role
        role_name `BACKUP_ROLE_NAME`
    OBJECT_END

    OBJECT backup_prep_role
        role_name `BACKUP_PREP_ROLE_NAME`
    OBJECT_END

    STATE backup_role_check
        found boolean = true
    STATE_END

    STATE backup_prep_role_check
        found boolean = true
    STATE_END

    CRI AND
        CTN aws_iam_role
            TEST all all AND
            STATE_REF backup_role_check
            OBJECT_REF backup_role
        CTN_END
        CTN aws_iam_role
            TEST all all AND
            STATE_REF backup_prep_role_check
            OBJECT_REF backup_prep_role
        CTN_END
    CRI_END
DEF_END
