# STIG CD16-00-004000: PostgreSQL, when using PKI-based authentication, must valida
# STIG ID: V-261893 (MEDIUM)

META
    esp_id `pg16-cd16-00-004000-pki-cert-validation-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `pg16`
    criticality `high`

    title `STIG CD16-00-004000: PostgreSQL, when using PKI-based authentication, must validate certificates by p`
    description `PostgreSQL, when using PKI-based authentication, must validate certificates by performing RFC 5280-compliant certification path validation.`
    author `example-security`
    tags `pg16,stig,disa-stig`

    control_mapping `DISA-STIG:CD16-00-004000,NIST-800-53:IA-5(2)(B)(1)`
    control_objective `IA-5(2)(B)(1)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `dba`

    control_origination `sp-system`
    inherited_from `PostgreSQL16:localhost:pg-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and remediate per DISA STIG guidance for CD16-00-004000.`

    component_id `comp-pg16-db`

    impl_IA_5_2_B_1 `This control is validated by checking the required PostgreSQL configuration against the DISA STIG baseline.`

META_END

DEF
    OBJECT pg_param_0
        parameter `ssl`
    OBJECT_END
    OBJECT pg_param_1
        parameter `ssl_ca_file`
    OBJECT_END

    STATE state_0
        found boolean = true
        value string = `on`
    STATE_END
    STATE state_1
        found boolean = true
        value string != ``
    STATE_END

    CRI AND
        CTN pg_config_param
            TEST all all AND
            STATE_REF state_0
            OBJECT_REF pg_param_0
        CTN_END
        CTN pg_config_param
            TEST all all AND
            STATE_REF state_1
            OBJECT_REF pg_param_1
        CTN_END
    CRI_END
DEF_END
