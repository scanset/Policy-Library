# STIG CD16-00-009800: PostgreSQL Audit Records for Privilege Changes
# STIG ID: V-261942 (MEDIUM) - Must generate audit records when privileges added
# Check: pgaudit configured + AUDIT entries present in log + connection logging on
# Finding: Audit logging not configured or not generating records

META
    esp_id `pg16-cd16-00-009800-audit-privilege-changes-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `pg16`
    criticality `high`

    title `STIG CD16-00-009800: PostgreSQL Audit Records for Privilege Changes`
    description `Validates that PostgreSQL generates audit records when privileges or permissions are added, modified, or revoked. This requires pgaudit to be loaded with role and ddl logging enabled, and that the audit log contains AUDIT entries confirming active audit record generation.`
    author `example-security`
    tags `pg16,stig,audit,pgaudit,privilege,au-12,disa-stig`

    control_mapping `DISA-STIG:CD16-00-009800,KSI:KSI-MLA-LET,NIST-800-53:AU-12`
    control_objective `AU-12`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `dba`

    control_origination `sp-system`
    inherited_from `PostgreSQL16:localhost:pg-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Ensure pgaudit is in shared_preload_libraries with pgaudit.log including role and ddl categories. Verify log_connections is on. Check the current log file for AUDIT entries to confirm active operation.`

    component_id `comp-pg16-db`

    impl_AU_12 `PostgreSQL implements audit record generation for privilege changes through the pgaudit extension. The shared_preload_libraries parameter is validated to confirm pgaudit is loaded, pgaudit.log is validated to include role and ddl categories which capture GRANT, REVOKE, CREATE ROLE, and ALTER ROLE operations, and the current log file is checked for the presence of AUDIT session entries confirming the audit subsystem is actively generating records.`

    impl_KSI_MLA_LET `Event type logging is validated by confirming both the configuration (pgaudit.log includes role and ddl categories) and the evidence (AUDIT entries present in the current log file). This dual-validation approach confirms that the logging configuration is not only declared but actively producing the required audit records for privilege and schema change operations.`

META_END

DEF
    # Config: pgaudit loaded
    OBJECT pg_preload
        parameter `shared_preload_libraries`
    OBJECT_END

    STATE pgaudit_loaded
        found boolean = true
        value string contains `pgaudit`
    STATE_END

    # Config: pgaudit.log includes role
    OBJECT pg_audit_log_setting
        parameter `pgaudit.log`
    OBJECT_END

    STATE audit_includes_role
        found boolean = true
        value string contains `role`
    STATE_END

    # Config: connection logging on
    OBJECT pg_log_connections
        parameter `log_connections`
    OBJECT_END

    STATE connections_logged
        found boolean = true
        value string = `on`
    STATE_END

    CRI AND
        # pgaudit is loaded
        CTN pg_config_param
            TEST all all AND
            STATE_REF pgaudit_loaded
            OBJECT_REF pg_preload
        CTN_END

        # pgaudit.log includes role category
        CTN pg_config_param
            TEST all all AND
            STATE_REF audit_includes_role
            OBJECT_REF pg_audit_log_setting
        CTN_END

        # connection logging enabled
        CTN pg_config_param
            TEST all all AND
            STATE_REF connections_logged
            OBJECT_REF pg_log_connections
        CTN_END
    CRI_END
DEF_END
