# STIG CD16-00-003800: PostgreSQL Password Hash Strength
# STIG ID: V-261891 (HIGH) - Must store only hashed, salted passwords
# Check: SELECT from pg_shadow -> all passwords must be SCRAM-SHA-256
# Finding: Weak or null password hash detected

META
    esp_id `pg16-cd16-00-003800-password-hashes-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `pg16`
    criticality `critical`

    title `STIG CD16-00-003800: PostgreSQL Password Hash Strength`
    description `Validates that all PostgreSQL accounts with passwords use SCRAM-SHA-256 hashing. Weak hash algorithms (MD5) or null passwords allow credential compromise through offline brute-force attacks or unauthenticated access.`
    author `example-security`
    tags `pg16,stig,passwords,hashing,disa-stig`

    control_mapping `DISA-STIG:CD16-00-003800`
    control_objective `IA-5(1)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `dba`

    control_origination `sp-system`
    inherited_from `PostgreSQL16:localhost:pg-hardening`
    customer_responsibility `configuration`

    remediation_days `1`
    recommendation `Set password_encryption to scram-sha-256 in postgresql.conf and reset all user passwords to regenerate hashes with the stronger algorithm.`

    component_id `comp-pg16-db`

    impl_IA_5_1 `PostgreSQL implements authenticator management by enforcing SCRAM-SHA-256 as the password hashing algorithm for all database accounts. The pg_shadow catalog is queried to confirm that every stored password hash uses the SCRAM-SHA-256 prefix, ensuring no accounts rely on the deprecated MD5 algorithm or have null password entries that would bypass authentication requirements.`

META_END

DEF
    OBJECT pg_password_check
        query `password_hashes`
    OBJECT_END

    STATE all_hashes_strong
        found boolean = true
        row_count int > 0
    STATE_END

    CRI AND
        CTN pg_catalog_query
            TEST all all AND
            STATE_REF all_hashes_strong
            OBJECT_REF pg_password_check
        CTN_END
    CRI_END
DEF_END
