META_END

DEF
    OBJECT pg_query
        query `role_attributes`
    OBJECT_END

    STATE query_check
        found boolean = true
    STATE_END

    CRI AND
        CTN pg_catalog_query
            TEST all all AND
            STATE_REF query_check
            OBJECT_REF pg_query
        CTN_END
    CRI_END
DEF_END
