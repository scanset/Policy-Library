# STIG CD16-00-004700: PostgreSQL must invalidate session identifiers upon user logout or other session
# STIG ID: V-261899 (MEDIUM)

META
    esp_id `pg16-cd16-00-004700-session-termination-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `pg16`
    criticality `high`

    title `STIG CD16-00-004700: PostgreSQL must invalidate session identifiers upon user logout or other session`
    description `PostgreSQL must invalidate session identifiers upon user logout or other session termination.`
    author `example-security`
    tags `pg16,stig,disa-stig`

    control_mapping `DISA-STIG:CD16-00-004700,NIST-800-53:SC-23(1)`
    control_objective `SC-23(1)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `dba`

    control_origination `sp-system`
    inherited_from `PostgreSQL16:localhost:pg-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and configure the required PostgreSQL parameters to meet compliance requirements.`

    component_id `comp-pg16-db`

    impl_SC_23_1 `PostgreSQL implements this control by validating the required configuration parameters are set to compliant values. The pg_config_param contract queries each parameter via SHOW and compares against the expected state.`

META_END

DEF
    OBJECT pg_param_0
        parameter `tcp_keepalives_idle`
    OBJECT_END

    OBJECT pg_param_1
        parameter `tcp_keepalives_interval`
    OBJECT_END

    OBJECT pg_param_2
        parameter `tcp_keepalives_count`
    OBJECT_END

    OBJECT pg_param_3
        parameter `statement_timeout`
    OBJECT_END

    STATE state_0
        found boolean = true
    STATE_END

    STATE state_1
        found boolean = true
    STATE_END

    STATE state_2
        found boolean = true
    STATE_END

    STATE state_3
        found boolean = true
    STATE_END

    CRI AND
        CTN pg_config_param
            TEST all all AND
            STATE_REF state_0
            OBJECT_REF pg_param_0
        CTN_END

        CTN pg_config_param
            TEST all all AND
            STATE_REF state_1
            OBJECT_REF pg_param_1
        CTN_END

        CTN pg_config_param
            TEST all all AND
            STATE_REF state_2
            OBJECT_REF pg_param_2
        CTN_END

        CTN pg_config_param
            TEST all all AND
            STATE_REF state_3
            OBJECT_REF pg_param_3
        CTN_END
    CRI_END
DEF_END
