# SRG SRG-APP-000014-WSR-000006: The web server must use encryption strength in accordance wi
# STIG ID: V-206352 (MEDIUM)
# Check: TLS probe of web server endpoint

META
    esp_id `web-srg-srg-app-000014-wsr-000006-tls-encryption-strength-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `web-server`
    criticality `high`

    title `SRG SRG-APP-000014-WSR-000006: The web server must use encryption strength in accordance with the categorizatio`
    description `The web server must use encryption strength in accordance with the categorization of data hosted by the web server when remote connections are provided.`
    author `example-security`
    tags `web-server,srg,disa-stig,tls,external`

    control_mapping `DISA-STIG:SRG-APP-000014-WSR-000006,NIST-800-53:AC-17(2)`
    control_objective `AC-17(2)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `WebServer:localhost:web-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and remediate per DISA Web Server SRG guidance for SRG-APP-000014-WSR-000006.`

    component_id `comp-web-server`

    impl_AC_17_2 `This control is validated by probing the web server configuration or network endpoint against the DISA Web Server SRG baseline.`

META_END

DEF
    VAR web_host string `localhost`
    VAR web_port string `443`

    OBJECT web_tls
        host VAR web_host
        port VAR web_port
    OBJECT_END

    STATE tls_check
        connected boolean = true
        protocol string = `TLSv1.2`
    STATE_END

    CRI AND
        CTN tls_probe
            TEST all all AND
            STATE_REF tls_check
            OBJECT_REF web_tls
        CTN_END
    CRI_END
DEF_END
