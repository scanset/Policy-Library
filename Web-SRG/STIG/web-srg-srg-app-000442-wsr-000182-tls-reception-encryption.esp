# SRG SRG-APP-000442-WSR-000182: The web server must maintain the confidentiality and integri
# STIG ID: V-206442 (MEDIUM)
# Check: TLS probe of web server endpoint

META
    esp_id `web-srg-srg-app-000442-wsr-000182-tls-reception-encryption-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `web-server`
    criticality `high`

    title `SRG SRG-APP-000442-WSR-000182: The web server must maintain the confidentiality and integrity of information du`
    description `The web server must maintain the confidentiality and integrity of information during reception.`
    author `example-security`
    tags `web-server,srg,disa-stig,tls,external`

    control_mapping `DISA-STIG:SRG-APP-000442-WSR-000182,NIST-800-53:SC-8(2)`
    control_objective `SC-8(2)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `WebServer:localhost:web-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and remediate per DISA Web Server SRG guidance for SRG-APP-000442-WSR-000182.`

    component_id `comp-web-server`

    impl_SC_8_2 `This control is validated by probing the web server configuration or network endpoint against the DISA Web Server SRG baseline.`

META_END

DEF
    VAR web_host string `localhost`
    VAR web_port string `443`

    OBJECT web_tls
        host VAR web_host
        port VAR web_port
    OBJECT_END

    STATE tls_check
        connected boolean = true
    STATE_END

    CRI AND
        CTN tls_probe
            TEST all all AND
            STATE_REF tls_check
            OBJECT_REF web_tls
        CTN_END
    CRI_END
DEF_END
