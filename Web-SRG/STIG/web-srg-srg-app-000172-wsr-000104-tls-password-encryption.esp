# SRG SRG-APP-000172-WSR-000104: The web server must encrypt passwords during transmission.
# STIG ID: V-206387 (MEDIUM)
# Check: TLS probe of web server endpoint

META
    esp_id `web-srg-srg-app-000172-wsr-000104-tls-password-encryption-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `web-server`
    criticality `high`

    title `SRG SRG-APP-000172-WSR-000104: The web server must encrypt passwords during transmission.`
    description `The web server must encrypt passwords during transmission.`
    author `example-security`
    tags `web-server,srg,disa-stig,tls,external`

    control_mapping `DISA-STIG:SRG-APP-000172-WSR-000104,NIST-800-53:IA-5(1)(C)`
    control_objective `IA-5(1)(C)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `WebServer:localhost:web-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and remediate per DISA Web Server SRG guidance for SRG-APP-000172-WSR-000104.`

    component_id `comp-web-server`

    impl_IA_5_1_C `This control is validated by probing the web server configuration or network endpoint against the DISA Web Server SRG baseline.`

META_END

DEF
    VAR web_host string `localhost`
    VAR web_port string `443`

    OBJECT web_tls
        host VAR web_host
        port VAR web_port
    OBJECT_END

    STATE tls_check
        connected boolean = true
    STATE_END

    CRI AND
        CTN tls_probe
            TEST all all AND
            STATE_REF tls_check
            OBJECT_REF web_tls
        CTN_END
    CRI_END
DEF_END
