META_END

DEF
    OBJECT target_file
        path `/etc/dconf/db/local.d/`
    OBJECT_END

    STATE content_check
        content string contains `picture-uri`
    STATE_END

    CRI AND
        CTN file_content
            TEST all all AND
            STATE_REF content_check
            OBJECT_REF target_file
        CTN_END
    CRI_END
DEF_END
