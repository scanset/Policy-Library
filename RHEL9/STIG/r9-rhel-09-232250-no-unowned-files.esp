META_END

DEF
    OBJECT fs_scan
        scan_type `nouser`
    OBJECT_END

    STATE scan_clean
        found boolean = true
        match_count int = 0
    STATE_END

    CRI AND
        CTN filesystem_scan
            TEST all all AND
            STATE_REF scan_clean
            OBJECT_REF fs_scan
        CTN_END
    CRI_END
DEF_END
