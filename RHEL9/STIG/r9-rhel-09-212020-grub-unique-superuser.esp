# STIG RHEL-09-212020: RHEL 9 must require a unique superusers name upon booting into single-user and m
# STIG ID: V-257789 (HIGH)

META
    esp_id `r9-rhel-09-212020-grub-unique-superuser-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `rocky9`
    criticality `critical`

    title `STIG RHEL-09-212020: RHEL 9 must require a unique superusers name upon booting into single-user and m`
    description `RHEL 9 must require a unique superusers name upon booting into single-user and maintenance modes.`
    author `example-security`
    tags `rhel9,stig,grub,boot,disa-stig`

    control_mapping `DISA-STIG:RHEL-09-212020,NIST-800-53:AC-3`
    control_objective `AC-3`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `Rocky9:localhost:os-hardening`
    customer_responsibility `configuration`

    remediation_days `1`
    recommendation `Review and remediate GRUB boot loader configuration per DISA STIG guidance for RHEL-09-212020.`

    component_id `comp-r9-os`

    impl_AC_3 `Boot loader security is validated through GRUB configuration inspection.`

META_END

DEF
    OBJECT grub_check
        config_path `/etc/grub2.cfg`
    OBJECT_END

    STATE grub_state
        found boolean = true
        has_superuser boolean = true
        superuser_is_common_name boolean = false
    STATE_END

    CRI AND
        CTN grub_config
            TEST all all AND
            STATE_REF grub_state
            OBJECT_REF grub_check
        CTN_END
    CRI_END
DEF_END
