# STIG RHEL-09-231045: /dev/shm mount requirements
# STIG ID: V-257850 (MEDIUM)

META
    esp_id `r9-rhel-09-231045-mount-dev-shm-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `rocky9`
    criticality `high`

    title `STIG RHEL-09-231045: RHEL 9 must prevent device files from being interpreted on file systems that con`
    description `RHEL 9 must prevent device files from being interpreted on file systems that contain user home directories.`
    author `example-security`
    tags `rhel9,stig,disa-stig,mount,filesystem`

    control_mapping `DISA-STIG:RHEL-09-231045,NIST-800-53:CM-7(2)`
    control_objective `CM-7(2)`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `Rocky9:localhost:os-hardening`
    customer_responsibility `configuration`

    remediation_days `30`
    recommendation `Review and remediate per DISA STIG guidance for RHEL-09-231045.`

    component_id `comp-r9-os`

    impl_CM_7_2 `This control is validated by checking the required system configuration against the DISA STIG baseline for RHEL 9.`

META_END

DEF
    OBJECT mount_check
        path `/dev/shm`
    OBJECT_END

    STATE mount_hardened
        found boolean = true
        nosuid boolean = true
        nodev boolean = true
        noexec boolean = true
    STATE_END

    CRI AND
        CTN mount_point
            TEST all all AND
            STATE_REF mount_hardened
            OBJECT_REF mount_check
        CTN_END
    CRI_END
DEF_END
