# STIG RHEL-09-231030: /var/log/audit mount requirements
# STIG ID: V-257847 (LOW)

META
    esp_id `r9-rhel-09-231030-mount-var-log-audit-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `rocky9`
    criticality `medium`

    title `STIG RHEL-09-231030: RHEL 9 must use a separate file system for the system audit data path.`
    description `RHEL 9 must use a separate file system for the system audit data path.`
    author `example-security`
    tags `rhel9,stig,disa-stig,mount,filesystem`

    control_mapping `DISA-STIG:RHEL-09-231030,NIST-800-53:AU-4`
    control_objective `AU-4`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `Rocky9:localhost:os-hardening`
    customer_responsibility `configuration`

    remediation_days `90`
    recommendation `Review and remediate per DISA STIG guidance for RHEL-09-231030.`

    component_id `comp-r9-os`

    impl_AU_4 `This control is validated by checking the required system configuration against the DISA STIG baseline for RHEL 9.`

META_END

DEF
    OBJECT mount_check
        path `/var/log/audit`
    OBJECT_END

    STATE mount_hardened
        found boolean = true
        nosuid boolean = true
        nodev boolean = true
        noexec boolean = true
    STATE_END

    CRI AND
        CTN mount_point
            TEST all all AND
            STATE_REF mount_hardened
            OBJECT_REF mount_check
        CTN_END
    CRI_END
DEF_END
