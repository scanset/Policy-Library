META_END

DEF
    OBJECT svc_check
        unit_name `debug-shell.service`
    OBJECT_END

    STATE svc_state
        found boolean = true
        load_state string = `masked`
    STATE_END

    CRI AND
        CTN systemd_service
            TEST all all AND
            STATE_REF svc_state
            OBJECT_REF svc_check
        CTN_END
