# KSI-CNA-EIS: Azure Defender for Servers - Standard Tier Enabled
# Azure 2.1.1: Ensure Microsoft Defender for Servers is enabled

META
    esp_id `ksi-cna-eis-az-defender-servers-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `azure`
    criticality `high`

    title `KSI-CNA-EIS: Azure Defender for Servers - Standard tier enabled`
    description `Validates that Microsoft Defender for Servers is enabled at the Standard pricing tier with P2 sub-plan, providing advanced threat protection including vulnerability assessment, adaptive hardening, and just-in-time VM access`
    author `security-team`
    tags `azure,defender,servers,threat-protection`

    control_mapping `KSI:KSI-CNA-EIS,NIST:SI-4,NIST:RA-5`
    control_objective `KSI-CNA-EIS`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `cloud-admin`

    control_origination `sp-system`
    customer_responsibility `configuration`

    remediation_days `7`
    recommendation `Enable Defender for Servers P2 via az security pricing create --name VirtualMachines --tier Standard --subplan P2`

    impl_KSI_CNA_EIS `Automated security posture enforcement is validated by confirming Microsoft Defender for Servers is enabled at the Standard pricing tier (pricingTier=Standard) with the P2 sub-plan. The P2 plan provides comprehensive server protection including real-time threat detection, vulnerability assessment, adaptive application controls, just-in-time VM access, file integrity monitoring, and integration with Microsoft Defender for Endpoint. The plan must not be deprecated and must be actively enabled (is_enabled=true).`

META_END

DEF
    OBJECT defender_vm
        name `VirtualMachines`
    OBJECT_END

    STATE st_defender_enabled
        found boolean = true
        pricing_tier string = `Standard`
        sub_plan string = `P2`
        is_enabled boolean = true
        deprecated boolean = false
    STATE_END

    CRI AND
        CTN az_defender_pricing
            TEST all all AND
            STATE_REF st_defender_enabled
            OBJECT_REF defender_vm
        CTN_END
    CRI_END
DEF_END
